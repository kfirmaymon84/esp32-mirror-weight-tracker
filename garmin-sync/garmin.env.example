# Copy this file to `garmin.env` (same folder) and fill in your values.
# `garmin.env` is gitignored — it holds your Garmin password, never commit it.

GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Your Apps Script web-app /exec URL and its shared token
# (same values as CLOUD_URL / CLOUD_TOKEN in esp32-mirror/src/secrets.h).
SHEET_URL=https://script.google.com/macros/s/XXXXXXXX/exec
SHEET_TOKEN=change-me
